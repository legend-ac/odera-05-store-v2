# ===== Server-only (Vercel / Functions) =====
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIRESTORE_DATABASE_ID=(default)
SMTP_USER=
SMTP_PASS=
EMAIL_BRAND_IMAGE_URL=
CRON_SECRET=
STORAGE_MODE=spark_public_only
ADMIN_ALLOWLIST_EMAILS=
ENABLE_APP_CHECK_VERIFY=false

# Backups only: 64 random hexadecimal characters. Keep the recovery key outside Git.
# Required as a GitHub Actions secret; not needed by the web application.
BACKUP_ENCRYPTION_KEY=

# ===== Client (NEXT_PUBLIC_*) =====
# Optional canonical shop URL; Vercel deployment variables are detected automatically.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_APP_CHECK_SITE_KEY=
NEXT_PUBLIC_FIRESTORE_DATABASE_ID=(default)
# optional (only if you later enable Storage)
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# optional (Cloudinary free auto-upload from admin)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
