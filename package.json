{
  "name": "odera-05-store",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:integrations": "node --conditions=react-server --import tsx scripts/check-integrations.ts",
    "measure:performance": "node scripts/measure-performance.mjs",
    "check:providers": "node --conditions=react-server --import tsx scripts/check-integrations.ts --providers",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "build:verify": "node scripts/build-quality.mjs",
    "clean:generated": "node scripts/clean-generated.mjs",
    "test:quality": "npm run test && npm run test:coverage && npm run test:e2e && npm run typecheck && npm run build:verify",
    "typecheck": "node scripts/typecheck-stable.mjs",
    "qa:full": "npm run lint && npm run test && npm run build && npm run typecheck",
    "format:check": "node -e \"console.log('No formatter configured')\"",
    "admin:set-claim": "tsx scripts/set-admin-claim.ts",
    "backup:run": "tsx scripts/backup.ts",
    "inventory:backfill": "tsx scripts/backfill-inventory.ts"
  },
  "dependencies": {
    "firebase": "^11.10.0",
    "firebase-admin": "^13.10.0",
    "next": "^15.5.28",
    "nodemailer": "^10.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hot-toast": "^2.6.0",
    "server-only": "^0.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^20.11.30",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^4.1.12",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.28",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.16.2",
    "typescript": "^5.4.5",
    "vitest": "^4.1.12",
    "vite": "~6.4.4"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.13.7"
    },
    "next": {
      "postcss": "$postcss"
    }
  }
}
